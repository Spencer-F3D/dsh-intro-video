{
  "name": "dsh-intro",
  "version": "1.0.0",
  "description": "DSH 產品介紹影片（Remotion，1920×1080 / 30fps / 90s，繁體中文字幕）",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.536",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.536",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio",
    "render": "remotion render DshIntro out/dsh-intro-1080p.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p",
    "still": "remotion still DshIntro out/still.png",
    "fonts": "node scripts/gen-glyphs.mjs && node scripts/fetch-fonts.mjs",
    "check": "node scripts/check-frames.mjs --sheet",
    "build": "remotion bundle",
    "typecheck": "tsc --noEmit",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "allowScripts": {
    "esbuild": false
  }
}
